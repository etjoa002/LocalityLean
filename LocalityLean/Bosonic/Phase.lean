import Mathlib.LinearAlgebra.Matrix.BilinearForm
import BosonicLean.Weyl.State
import LinearAQFT.Symplectic.Net
import LocalityLean.Core.Support

/-!
# The lattice phase space and the bosonic net

The phase space of harmonic bosons on a finite set of sites `Λ` is `Λ × Fin 2 → ℝ` (a position
and a momentum coordinate per site; the coordinate `0` is `q`, the coordinate `1` is `p`), with
the symplectic form `σ(f, g) = ∑_x (f_x^q g_x^p - f_x^p g_x^q)` (M5, Definition 2.1). The CCR
algebra over it is BosonicLean's, and the net `X ↦ 𝒜(X)` is generated by the Weyl operators
`W(f)` with `supp f ⊆ X`, through LinearAQFT's symplectic net (M5, Definition 2.3); it is causal
for the lattice index because disjoint supports have `σ(f, g) = 0` (M5, Propositions 3.1
and 3.3).

## Main definitions

* `LocalityLean.Bosonic.Phase`, `Omega`, `sigma`, `SuppIn`, `loc`.
* `LocalityLean.Bosonic.phaseSpace`, `weylNet`, `weylNet_isCausal`, `wCCR_mem_weylNet`.
-/

namespace LocalityLean.Bosonic

open scoped Matrix
open BosonicLean BosonicLean.Weyl LinearAQFT LinearAQFT.Symplectic

variable (Λ : Type*) [Fintype Λ] [DecidableEq Λ]

/-- The phase space: a position (`0`) and a momentum (`1`) coordinate at every site. -/
abbrev Phase := Λ × Fin 2 → ℝ

/-- The other coordinate at the same site: `(x, q) ↦ (x, p)` and `(x, p) ↦ (x, q)`. -/
def conj {Λ : Type*} (b : Λ × Fin 2) : Λ × Fin 2 := (b.1, if b.2 = 0 then 1 else 0)

/-- The matrix of the symplectic form: `Ω_{(x,q),(x,p)} = 1`, `Ω_{(x,p),(x,q)} = -1`, all other
entries `0`. -/
def Omega : Matrix (Λ × Fin 2) (Λ × Fin 2) ℝ :=
  Matrix.of fun b a => if b.1 = a.1 then
    (if b.2 = 0 ∧ a.2 = 1 then 1 else if b.2 = 1 ∧ a.2 = 0 then -1 else 0) else 0

/-- The symplectic form `σ(f, g) = f ⬝ Ω g = ∑_x (f_x^q g_x^p - f_x^p g_x^q)` (M5,
Definition 2.1). -/
noncomputable def sigma : LinearMap.BilinForm ℝ (Phase Λ) := Matrix.toBilin' (Omega Λ)

variable {Λ}

theorem sigma_apply (f g : Phase Λ) :
    sigma Λ f g = ∑ x, (f (x, 0) * g (x, 1) - f (x, 1) * g (x, 0)) := by
  rw [sigma, Matrix.toBilin'_apply', dotProduct, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun x _ => ?_
  simp [Fin.sum_univ_two, Matrix.mulVec, dotProduct, Fintype.sum_prod_type, Omega, ite_mul,
    Finset.sum_ite_eq]
  ring

omit [Fintype Λ] in
theorem Omega_transpose : (Omega Λ)ᵀ = -Omega Λ := by
  ext ⟨x, i⟩ ⟨y, j⟩
  by_cases h : x = y
  · subst h
    fin_cases i <;> fin_cases j <;> simp [Omega]
  · simp [Omega, h, Ne.symm h]

theorem Omega_mul_Omega : Omega Λ * Omega Λ = -1 := by
  ext ⟨x, i⟩ ⟨y, j⟩
  by_cases h : x = y
  · subst h
    fin_cases i <;> fin_cases j <;> simp [Omega, Matrix.mul_apply, Fintype.sum_prod_type]
  · simp [Omega, Matrix.mul_apply, Fintype.sum_prod_type, Fin.sum_univ_two, h]

/-- M5, Proposition 3.1: `σ` is alternating. -/
theorem sigma_isAlt : (sigma Λ).IsAlt := by
  intro f
  rw [sigma_apply]
  exact Finset.sum_eq_zero fun x _ => by ring

/-- `f` is supported in the region `X`: both coordinates vanish at every site off `X`. -/
def SuppIn (f : Phase Λ) (X : Set Λ) : Prop :=
  ∀ x, x ∉ X → f (x, 0) = 0 ∧ f (x, 1) = 0

omit [Fintype Λ] [DecidableEq Λ] in
theorem SuppIn.mono {f : Phase Λ} {X Y : Set Λ} (h : SuppIn f X) (hXY : X ⊆ Y) : SuppIn f Y :=
  fun x hx => h x fun hxX => hx (hXY hxX)

omit [Fintype Λ] [DecidableEq Λ] in
theorem SuppIn.apply_eq_zero {f : Phase Λ} {X : Set Λ} (h : SuppIn f X) {b : Λ × Fin 2}
    (hb : b.1 ∉ X) : f b = 0 := by
  obtain ⟨x, i⟩ := b
  rcases (h x hb) with ⟨h0, h1⟩
  fin_cases i
  · exact h0
  · exact h1

/-- M5, Proposition 3.1: `σ(f, g) = 0` for disjoint supports. -/
theorem sigma_eq_zero_of_disjoint {f g : Phase Λ} {X Y : Set Λ} (hf : SuppIn f X)
    (hg : SuppIn g Y) (hXY : Disjoint X Y) : sigma Λ f g = 0 := by
  rw [sigma_apply]
  refine Finset.sum_eq_zero fun x _ => ?_
  by_cases hx : x ∈ X
  · have hxY : x ∉ Y := fun hy => Set.disjoint_left.1 hXY hx hy
    rw [(hg x hxY).1, (hg x hxY).2]; ring
  · rw [(hf x hx).1, (hf x hx).2]; ring

variable (Λ) in
/-- The test functions supported in `X`, as a submodule, monotone in `X`. -/
def loc : Set Λ →o Submodule ℝ (Phase Λ) where
  toFun X :=
    { carrier := {f | SuppIn f X}
      zero_mem' := fun x _ => ⟨rfl, rfl⟩
      add_mem' := fun {f g} hf hg x hx => by
        simp only [Pi.add_apply, (hf x hx).1, (hf x hx).2, (hg x hx).1, (hg x hx).2, add_zero,
          and_self]
      smul_mem' := fun c {f} hf x hx => by
        simp only [Pi.smul_apply, (hf x hx).1, (hf x hx).2, smul_zero, and_self] }
  monotone' := fun X Y hXY f hf => SuppIn.mono hf hXY

omit [Fintype Λ] [DecidableEq Λ] in
@[simp] theorem mem_loc {f : Phase Λ} {X : Set Λ} : f ∈ loc Λ X ↔ SuppIn f X := Iff.rfl

variable (Λ) in
/-- The lattice phase space as phase-space data over the lattice index (LinearAQFT's
`PhaseSpace`): test functions are phase-space vectors, `cls` is the identity. -/
noncomputable def phaseSpace : PhaseSpace (latticeIndex Λ) (Phase Λ) (Phase Λ) where
  loc := loc Λ
  exists_mem_loc := fun _ => ⟨Set.univ, fun x hx => absurd (Set.mem_univ x) hx⟩
  sigma := sigma Λ
  isAlt := sigma_isAlt
  cls := LinearMap.id
  cls_surjective := Function.surjective_id
  causal := fun X Y hXY _ hf _ hg =>
    sigma_eq_zero_of_disjoint hf hg ((latticeIndex_orthogonal_iff X Y).1 hXY)
  timeSlice := fun X Y hXY f hf =>
    ⟨f, SuppIn.mono hf ((latticeIndex_dependent_iff X Y).1 hXY), rfl⟩

variable (Λ) in
/-- M5, Definition 2.3: the bosonic net, `𝒜(X)` generated by the Weyl operators of the
functions supported in `X`. -/
noncomputable def weylNet : Net (Set Λ) (CCR (sigma Λ)) := ccrNet (phaseSpace Λ)

/-- M5, Proposition 3.3: the bosonic net is causal for the lattice index. -/
theorem weylNet_isCausal : Net.IsCausal (latticeIndex Λ) (weylNet Λ) :=
  LinearAQFT.Symplectic.weylNet_isCausal (phaseSpace Λ) _

/-- The Weyl operator of a function supported in `X` lies in `𝒜(X)`. -/
theorem wCCR_mem_weylNet {f : Phase Λ} {X : Set Λ} (hf : SuppIn f X) :
    wCCR (sigma Λ) f ∈ weylNet Λ X :=
  Net.subset_generated (generators (phaseSpace Λ) (CCR.weylSystem _ (phaseSpace Λ).isAlt)) X
    ⟨f, hf, rfl⟩

end LocalityLean.Bosonic
